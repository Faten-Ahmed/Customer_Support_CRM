{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "AZM-CRM-API"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CrmDb;User Id=sa;Password=YOUR_SA_PASSWORD;TrustServerCertificate=true;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_STRONG_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "azm-crm-api",
    "Audience": "azm-crm-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Hangfire": {
    "DashboardPath": "/hangfire"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "CONFIGURE_IN_ENVIRONMENT_OR_DEV_SETTINGS",
    "Password": "CONFIGURE_IN_ENVIRONMENT_OR_DEV_SETTINGS",
    "FromAddress": "CONFIGURE_IN_ENVIRONMENT_OR_DEV_SETTINGS",
    "FromName": "AZM CRM Support"
  },
  "AllowedHosts": "*"
}
